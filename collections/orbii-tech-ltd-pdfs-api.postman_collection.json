          "id": "72c0b513-f9b7-4ad8-923b-2f7d6f470868",
          "name": "Trigger PDF extraction pipeline",
          "request": {
            "name": "Trigger PDF extraction pipeline",
            "description": {
              "content": "Starts the pipeline to process PDF data for the specified customer. An optional `mode` parameter allows specifying whether to override or append to existing data (defaults to `Override`).\nIf a pipeline is already running for the same customer_id, this endpoint will return a 409 Conflict response.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "start-pdf-extraction"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "user",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "password",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "customer_id",
                  "value": "<uuid>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "mode",
                  "value": "Override",
                  "type": "text",
                  "description": "Optional. Determines how PDF data is processed in the pipeline.   Allowed values are `Override` (default) and `Append`.\n (This can only be one of Override,Append)"
                }
              ]
            }
