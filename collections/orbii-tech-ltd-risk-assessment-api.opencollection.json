        {
          "info": {
            "name": "Get band classification for all customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.foodics.orbii.ai/band_classification",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "query",
                "description": "Database username."
              },
              {
                "name": "password",
                "value": "",
                "type": "query",
                "description": "Database password."
              }
            ]
          },
          "docs": "Returns band classification scores, values, total score, band, and red flag reasons  for all customer IDs.\n"
        }
