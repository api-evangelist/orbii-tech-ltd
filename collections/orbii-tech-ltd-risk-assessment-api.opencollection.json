          "http": {
            "method": "POST",
            "url": "https://api.foodics.orbii.ai/rerun-assessment",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "user",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Triggers the pipeline to rerun the assessment."
