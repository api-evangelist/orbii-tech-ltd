        {
          "info": {
            "name": "Trigger Risk Assessment Pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.foodics.orbii.ai/Micro_Loan_Rerun_Assessment",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "user",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Triggers the Azure Data Factory pipeline `RerunRiskAssessment` using provided user credentials."
        },
        {
          "info": {
            "name": "Get risk assessment for a specific customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.foodics.orbii.ai/risk_assessment/customer/:customer_id",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "path",
                "description": "The unique customer identifier (GUID)."
              },
              {
                "name": "user",
                "value": "",
                "type": "query",
                "description": "Database username (optional if set via environment variables)."
              },
              {
                "name": "password",
                "value": "",
                "type": "query",
                "description": "Database password (optional if set via environment variables)."
              }
            ]
          },
          "docs": "Returns a list of risk assessment rules and scores for the specified customer."
        },
        {
          "info": {
            "name": "Get band classification for a specific customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.foodics.orbii.ai/band_classification/customer/:customer_id",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "path",
                "description": "The unique customer identifier (GUID)."
              },
              {
                "name": "user",
                "value": "",
                "type": "query",
                "description": "Database username (optional if set via environment variables)."
              },
              {
                "name": "password",
                "value": "",
                "type": "query",
                "description": "Database password (optional if set via environment variables)."
              }
            ]
          },
          "docs": "Returns the band classification, component scores, score values, total score, and red flag reason for the specified customer."
        },
        {
          "info": {
            "name": "Update a KPI rule threshold",
            "type": "http"
