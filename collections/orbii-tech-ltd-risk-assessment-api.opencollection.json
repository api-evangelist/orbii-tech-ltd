        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all KPI rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.foodics.orbii.ai/Micro_Loan_KPI_Rules",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "query"
              },
              {
                "name": "password",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get all KPI rules"
        },
        {
          "info": {
            "name": "Get paginated full risk assessment data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.foodics.orbii.ai/Micro_Loan_Risk_Assessment",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "query"
              },
              {
                "name": "password",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (must be >= 1)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of records per page (must be >= 1)"
              }
            ]
          },
          "docs": "Get paginated full risk assessment data"
