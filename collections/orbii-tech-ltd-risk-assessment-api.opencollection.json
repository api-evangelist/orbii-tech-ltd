          "http": {
            "method": "POST",
            "url": "https://api.foodics.orbii.ai/Micro_Loan_UpdateKpiRules",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "user",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                },
                {
                  "name": "category",
                  "value": ""
                },
                {
                  "name": "rule",
                  "value": ""
                },
                {
                  "name": "new_threshold",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Update KPI rule threshold"
