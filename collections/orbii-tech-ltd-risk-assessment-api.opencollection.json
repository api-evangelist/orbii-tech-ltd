          "http": {
            "method": "POST",
            "url": "https://api.foodics.orbii.ai/update-kpi-rule",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "category",
                  "value": ""
                },
                {
                  "name": "rule",
                  "value": ""
                },
                {
                  "name": "new_threshold",
                  "value": ""
                },
                {
                  "name": "user",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates a KPI rule threshold."
